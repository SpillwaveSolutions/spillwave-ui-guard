{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/remind-ui-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/remind-ui-guard.sh"
          }
        ]
      }
    ],
    "afterFileEdit": [
      {
        "command": "./hooks/remind-ui-guard.sh"
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/remind-ui-guard.sh"
      }
    ]
  },
  "description": "Codex port of Claude Code hooks. Same scripts; ExitPlanMode omitted (no such tool)."
}
